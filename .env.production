# `yarn build` / `yarn build --mode production` (docker 이미지 빌드 포함) 시 자동 적용됩니다.
# 목업(더미데이터)을 끄고 실제 백엔드 API를 사용합니다.
VITE_USE_MOCK=false

# ℹ️ VITE_API_BASE_URL 은 여기서 정하지 않습니다.
#    NAS 배포에서는 nginx 가 /api 를 backend 로 프록시하므로
#    GitHub Actions 가 build-arg 로 '/api' 를 주입합니다.
#    (deploy/frontend.Dockerfile, .github/workflows/deploy.yml 참고)
#    로컬에서 다른 주소를 쓰려면 .env.production.local 에 넣으세요.
