# NAS(docker compose) 배포용 환경변수. 복사해서 .env 로 저장 후 값을 채우세요.
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 이 저장소는 PUBLIC 이므로
# 실제 비밀번호가 여기(.env.example)에 들어가지 않도록 주의하세요.

# ⚠️ NAS 자동 배포(GitHub Actions)는 이 파일을 읽지 않습니다.
#    러너가 checkout 한 디렉터리에는 .env 가 없기 때문입니다(.gitignore).
#    DB 비밀번호와 JWT_SECRET 은 저장소 Settings > Secrets and variables > Actions 에
#    등록한 값이 사용됩니다. 아래 값들은 "NAS 에서 수동으로 compose 를 돌릴 때"와
#    "로컬 docker-compose.yml 로 개발할 때"만 쓰입니다. 두 곳의 값은 반드시 일치시키세요.

# ── 데이터베이스 ────────────────────────────────────────────
# 이 비밀번호들은 최초 컨테이너 생성 시 DB 에 그대로 반영됩니다.
# 나중에 바꾸려면 DB 안에서 직접 변경해야 하므로 처음에 제대로 정하세요.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=suwon_es_admin
MYSQL_USER=suwon_app
MYSQL_PASSWORD=change_me_app

# ── 인증 ───────────────────────────────────────────────────
# 반드시 무작위 문자열로 바꾸세요:  openssl rand -hex 32
# 이 값을 바꾸면 기존 로그인 세션이 모두 무효화됩니다.
JWT_SECRET=change_me_to_a_long_random_string

# ── 포트 ───────────────────────────────────────────────────
# 브라우저로 접속하는 주소는 http://<NAS_IP>:8080 입니다.
# DB(3306)와 백엔드(4000)는 의도적으로 발행하지 않습니다.
# 브라우저는 프론트 nginx 의 /api 프록시를 통해서만 백엔드에 접근합니다.
FRONTEND_PORT=8080

# 목업 데모 페이지 (백엔드/DB 불필요, --profile demo 로만 기동)
FRONTEND_TEST_PORT=8081

# ── 선택 항목 ──────────────────────────────────────────────
# CORS: 프론트와 API 가 same-origin(/api 프록시)이라 보통 비워둡니다.
# 외부 도구로 API 를 직접 호출해야 할 때만 채우세요.
# CORS_ORIGIN=

# 이미지 태그 고정 / 롤백용. 비워두면 :main 최신을 사용합니다.
# GitHub Actions 배포는 이 값들을 커밋 SHA 로 자동 지정합니다.
# WEB_IMAGE=ghcr.io/sangwookjeong/suwon-es-web:main
# API_IMAGE=ghcr.io/sangwookjeong/suwon-es-api:main
# DB_IMAGE=ghcr.io/sangwookjeong/suwon-es-db:main

# ── GitHub Actions 셀프 호스티드 러너 ───────────────────────
# deploy/github-runner-compose.yml 에서 사용합니다.
# 토큰은 classic PAT + repo 권한으로 발급하세요.
GH_RUNNER_REPO_URL=https://github.com/SangwookJeong/suwon_es_admin
GH_RUNNER_TOKEN=change_me_github_personal_access_token

# ℹ️ VITE_API_BASE_URL 은 여기서 설정하지 않습니다.
#    빌드 타임에 번들로 구워지는 값이라 GitHub Actions 에서 '/api' 로 고정 주입합니다.
#    (deploy/frontend.Dockerfile 참고)
